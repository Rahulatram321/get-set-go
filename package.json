{
  "name": "orbitqueue",
  "version": "1.0.0",
  "private": true,
  "description": "OrbitQueue - Reliable background execution for modern systems",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @orbitqueue/database migrate",
    "db:seed": "pnpm --filter @orbitqueue/database seed",
    "db:generate": "pnpm --filter @orbitqueue/database generate",
    "demo": "pnpm db:seed && pnpm --filter @orbitqueue/worker demo",
    "setup:local": "bash scripts/setup-local.sh",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
